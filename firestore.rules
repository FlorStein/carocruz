rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'admin@caracruz.com.ar',
          'admin@carocruz.com.ar'
        ];
    }

    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalText(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isValidEmail(value) {
      return value is string &&
        value.size() <= 254 &&
        value.matches('^[^\\s@]{1,64}@[^\\s@]{1,253}\\.[^\\s@]{2,}$');
    }

    // Productos: lectura pública, escritura solo admin
    match /productos_admin/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Overrides de producto
    match /productos_overrides/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Configuración comercial
    match /config_admin/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Pedidos: solo escritura del backend (Cloud Functions con Admin SDK, bypasea reglas)
    // Lectura: admin ve todos; el comprador solo ve sus propios pedidos (por email)
    match /pedidos/{pedidoId} {
      allow read: if isAdmin() ||
        (request.auth != null &&
         request.auth.token.email != null &&
         (
           resource.data.comprador.emailLower == request.auth.token.email.lower() ||
           resource.data.comprador.email == request.auth.token.email
         ));
      allow create, update, delete: if false; // solo el backend (Admin SDK) puede escribir
    }

    // Perfiles de usuario
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['nombre', 'email', 'direccion', 'updatedAt']) &&
        isText(request.resource.data.nombre, 100) &&
        isValidEmail(request.resource.data.email) &&
        request.resource.data.email == request.auth.token.email &&
        isOptionalText(request.resource.data.direccion, 180) &&
        request.resource.data.updatedAt is int;
    }

    // Suscriptores newsletter: cualquiera puede crear (sin auth), solo admin puede leer
    match /suscriptores/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'email', 'createdAt']) &&
        isText(request.resource.data.nombre, 100) &&
        isValidEmail(request.resource.data.email) &&
        request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }
  }
}
